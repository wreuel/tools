{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "diamond",
          "foreground": "#ffffff",
          "background": "#c386f1",
          "template": " {{ .UserName }} ",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b0"
        },
        {
          "type": "path",
          "style": "powerline",
          "foreground": "#ffffff",
          "background": "#ff479c",
          "template": " \uea83  {{ .Path }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "folder_separator_icon": " \ue0b1 ",
            "home_icon": "~",
            "style": "folder"
          }
        },
        {
          "type": "node",
          "style": "powerline",
          "foreground": "#ffffff",
          "background": "#6CA35E",
          "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "fetch_version": true
          }
        },
        {
          "type": "npm",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "template": " \ue71e {{ .Full }} ",
          "foreground": "#ffffff",
          "background": "#CB3837"
        },
        {
          "type": "angular",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "template": " \ue753 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#ffffff",
          "background": "#DD0031"
        },
        {
          "type": "dotnet",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "template": " .NET {{ if .Unsupported }}\uf071{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#ffffff",
          "background": "#512BD4"
        },
        {
          "type": "azfunc",
          "style": "powerline",
          "foreground": "#ffffff",
          "background": "#0078D4",
          "template": " \uf0e7{{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "display_mode": "files",
            "fetch_version": false
          }
        },
        {
          "type": "aws",
          "style": "powerline",
          "foreground": "#ffffff",
          "background": "#FF9900",
          "background_templates": [
            "{{if contains \"default\" .Profile}}#FFA400{{end}}",
            "{{if contains \"jan\" .Profile}}#f1184c{{end}}"
          ],
          "template": " \ue7ad {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "display_default": false
          }
        },
        {
          "type": "root",
          "style": "powerline",
          "foreground": "#111111",
          "background": "#ffff66",
          "template": " \uf0ad ",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "foreground": "#ffffff",
          "background": "#83769c",
		  "powerline_symbol": "\ue0b0",
          "template": " \ueba2 {{ .FormattedMs }}\u2800",
          "options": {
            "always_enabled": true
          }
        },
        {
          "type": "claude",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "template": " \uf0bc9 {{ .Model.DisplayName }} \uf2d0 {{ .TokenUsagePercent.Gauge }}",
          "foreground": "#ffffff",
          "background": "#D97757"
        },
        {
          "type": "copilot",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "template": " \uec1e {{ .Premium.Percent.Gauge }} ",
          "cache": {
            "duration": "168h",
            "strategy": "folder"
          },
          "foreground": "#ffffff",
          "background": "#0EA5E9"
        },
        {
          "type": "git",
          "style": "powerline",
          "foreground": "#193549",
          "background": "#fffb38",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FF9248{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#ff4500{{ end }}",
            "{{ if gt .Ahead 0 }}#B388FF{{ end }}",
            "{{ if gt .Behind 0 }}#B388FF{{ end }}"
          ],
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "powerline_symbol": "\ue0b0",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "options": {
            "branch_template": "{{ trunc 25 .Branch }}",
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        },
        {
          "type": "status",
          "style": "diamond",
          "foreground": "#ffffff",
          "background": "#00897b",
		  "powerline_symbol": "\ue0b0",
          "background_templates": [
            "{{ if gt .Code 0 }}#e91e63{{ end }}"
          ],
          "template": " \ue23a ",
          "trailing_diamond": "\ue0b4",
          "options": {
            "always_enabled": true
          }
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "shell",
          "style": "plain",
          "foreground": "#ffffff",
          "background": "#0077c2",
          "template": "<#0077c2,transparent>\ue0b6</> \uf489 {{ .Name }} <transparent,#0077c2>\ue0b2</>",
          "powerline_symbol": "\ue0b2"
        },
     
        {
          "type": "battery",
          "style": "powerline",
          "foreground": "#ffffff",
          "background": "#f36943",
          "background_templates": [
            "{{if eq \"Charging\" .State.String}}#40c4ff{{end}}",
            "{{if eq \"Discharging\" .State.String}}#ff5722{{end}}",
            "{{if eq \"Full\" .State.String}}#4caf50{{end}}"
          ],
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }}\uf295 ",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "options": {
            "charged_icon": "\ue22f ",
            "charging_icon": "\ue234 ",
            "discharging_icon": "\ue231 "
          }
        },
        {
          "type": "time",
          "style": "diamond",
          "foreground": "#111111",
          "background": "#2e9599",
          "template": " {{ .CurrentDate | date .Format }} ",
		  
          "leading_diamond": "\ue0b2",
          "trailing_diamond": "\ue0b4"
        }
      ]
    }
  ]
}